generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  creadoEn     DateTime  @default(now())
  gastos       Gasto[]
  ingresos     Ingreso[]
}

model Gasto {
  id          Int         @id @default(autoincrement())
  descripcion String
  monto       Float
  categoria   String
  fecha       DateTime    @default(now())
  creadoEn    DateTime    @default(now())
  lugar       String?
  items       ItemGasto[]
  usuarioId   Int
  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model ItemGasto {
  id             Int    @id @default(autoincrement())
  producto       String
  cantidad       Float
  precioUnitario Float
  gastoId        Int
  gasto          Gasto  @relation(fields: [gastoId], references: [id], onDelete: Cascade)
}

model Ingreso {
  id          Int      @id @default(autoincrement())
  descripcion String
  monto       Float
  categoria   String
  fecha       DateTime @default(now())
  creadoEn    DateTime @default(now())
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}